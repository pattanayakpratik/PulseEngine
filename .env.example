# PulseEngine Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
API_KEY=pulse_live_test_api_key_884920
IDEMPOTENCY_EXPIRE_SECONDS=86400

# PostgreSQL (Async SQLAlchemy 2.0 with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pulse_engine
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/pulse_engine

# Redis 7 Configuration
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Circuit Breaker Limits
RATE_LIMIT_FCM_RPS=500
RATE_LIMIT_WHATSAPP_RPS=80
RATE_LIMIT_SMTP_RPS=50
RATE_LIMIT_WEBHOOK_RPS=200

CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
CIRCUIT_BREAKER_MIN_REQUESTS=20
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

# Worker Tuning
OUTBOX_BATCH_SIZE=500
OUTBOX_POLL_INTERVAL_MS=100
BULK_STREAM_BATCH_SIZE=5000
